# === LLM Configuration (OpenAI-compatible: OpenAI / DeepSeek / Qwen / vLLM) ===
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Optional lighter model for background memory extraction (defaults to LLM_MODEL)
MEMORY_LLM_MODEL=

# === Embedding Configuration ===
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === Reranker Configuration ===
RERANKER_ENABLED=false
RERANKER_API_KEY=
RERANKER_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=4
RERANKER_MIN_SCORE=0.35

# === PostgreSQL (pgvector) ===
# 默认映射到宿主 5433 端口并使用 127.0.0.1，避免与本机 5432 及 Windows IPv6 ::1 冲突
POSTGRES_DSN=postgresql://cs_agent:cs_agent_pass@127.0.0.1:5433/cs_agent?sslmode=disable

# 本地未启动 Docker Desktop 时自动降级到内存存储，便于直接预览 Web UI 与模型配置
LOCAL_DEV_FALLBACK=true

# === Redis ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Agent Loop & Memory Tuning ===
MAX_TOOL_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=10.0
SHORT_TERM_MAX_TURNS=10
SESSION_TTL_SECONDS=1800
SESSION_LOCK_TTL_SECONDS=60
SESSION_LOCK_WAIT_SECONDS=5.0
LONG_TERM_TOP_K=3
LONG_TERM_MIN_SCORE=0.35
LONG_TERM_SUMMARY_EVERY_N_TURNS=10
TOOL_CACHE_TTL_SECONDS=60
